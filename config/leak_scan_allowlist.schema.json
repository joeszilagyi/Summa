{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/summa/leak_scan_allowlist.schema.json",
  "title": "leak-scan-allowlist.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "leak-scan-allowlist.v2"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "finding_fingerprint",
        "reason",
        "approved_by",
        "expires_at"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "minLength": 1
        },
        "finding_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:+-]{1,127}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
